{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mixer",
  "version": "1.0.0",
  "identifier": "com.mixer.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Mixer",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/llama-server"
    ],
    "resources": [
      "binaries/*.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyRTg0MzFEM0JGMEJEMzUKUldRMXZmQTdIVVBvRWhnUE9rR1h2N3VsWFA0N1ArT0xFRDExV1hBNk5MSXRVbU9sNlM3cUc0eVkK",
      "endpoints": [
        "https://github.com/ArtemPodloboshnikov/Mixer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
